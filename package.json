{
  "name": "Lojas Cloud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"const fs = require('fs'); if (fs.existsSync('dist_prebuilt') && fs.readdirSync('dist_prebuilt').length > 0) { console.log('>>> [CloudX Optimizer] Pasta dist_prebuilt/ ja existe! Pulando compilação pesada para economizar RAM.'); process.exit(0); } else { console.log('>>> [CloudX Optimizer] Pasta dist_prebuilt/ nao encontrada. Iniciando compilação...'); require('child_process').execSync('NODE_OPTIONS=--max-old-space-size=768 vite build', {stdio: \\\"inherit\\\"}); }\"",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "prod": "npm run build && npm start"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@supabase/supabase-js": "2.39.7",
    "@types/react-datepicker": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dotenv": "^17.3.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "2.3.8",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "mercadopago": "^2.12.0",
    "react": "^19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
