{
  "rewrites": [
    {
      "source": "/api/device-test/:idOrToken",
      "destination": "/api/device-test?idOrToken=:idOrToken"
    },
    {
      "source": "/api/os-tracking/:token",
      "destination": "/api/os-tracking?token=:token"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

